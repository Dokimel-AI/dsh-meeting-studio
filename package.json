{
  "name": "dsh-meeting-studio",
  "version": "0.1.0-fork.1",
  "forkedFrom": "https://github.com/kekydream/dsh-meeting-room",
  "description": "会议记录：本机转写、发言人分离、要点与工作安排、手写笔记、复盘与纪要 · Meeting notes inside DeepSeek Harness",
  "author": "Dokimel AI <lion20231226@outlook.com> (https://github.com/Dokimel-AI)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dokimel-AI/dsh-meeting-studio.git"
  },
  "homepage": "https://github.com/Dokimel-AI/dsh-meeting-studio#readme",
  "bugs": {
    "url": "https://github.com/Dokimel-AI/dsh-meeting-studio/issues",
    "email": "lion20231226@outlook.com"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "meeting",
    "minutes",
    "transcription",
    "speaker-diarization",
    "handwriting",
    "会议记录",
    "会议纪要",
    "转写",
    "发言人分离"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host-*.js",
    "skill-meeting-scribe.js",
    "speaker-worker.js",
    "handwriting-worker.js",
    "minutes-docx.py",
    "scores-xlsx.py",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "MODELS.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "PUBLISHING.md",
    "DESIGN.md",
    "FEATURES.md",
    "TESTING.md",
    "smoke.mjs",
    "tools/*.mjs"
  ],
  "license": "MIT",
  "dependencies": {
    "onnxruntime-node": "1.20.1",
    "pinyin-pro": "^3.27.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "1.13.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node"
    ]
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "contributors": [
    {
      "name": "杨道泉",
      "email": "yangdaoquan@qq.com",
      "url": "https://github.com/kekydream/dsh-meeting-room",
      "note": "upstream author of dsh-meeting-room, the base of this fork"
    }
  ]
}
